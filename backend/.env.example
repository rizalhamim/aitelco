# Copy to backend/.env and fill in. config.py loads this file at startup.
# Every key has a default in code, so a missing key fails silently; set them all in production.

# ---- Runtime ----
# "production" makes the server refuse to start with the public default JWT secret.
APP_ENV=development
# Comma-separated allowed browser origins. "*" is fine behind the Next.js /api rewrite.
CORS_ORIGINS=*

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480

# ---- LLM (OpenAI-compatible router) ----
LLM_BASE=
LLM_KEY=
LLM_MODEL=Agent-Java-v02.3
LLM_MODEL_FAST=Agent-Java-v02.3-Flash
LLM_MODEL_SQL=Agent-Java-v02.3-SQL
LLM_MODEL_CODER=Agent-Java-v02.3-Coder
LLM_MODEL_ANALYST=Agent-Java-v02.3-Analyst
LLM_OMIT_TEMPERATURE=true

# ---- BigQuery ----
BQ_PROJECT=data-java-prd-97b9
BQ_DATASET=java_precalc
BQ_LOCATION=asia-southeast2
# Path to an Application Default Credentials JSON file
BQ_ADC=
MAX_BYTES_BILLED=53687091200
DEFAULT_ROW_LIMIT=1000
QUERY_TIMEOUT_S=120

# ---- Storage / geo ----
TELCO_AI_DB=
KEC_SHP_PATH=

# ---- Email (login codes, password reset, summaries) ----
SMTP_HOST=mail.bizplan-java.com
SMTP_PORT=587
SMTP_USER=notification@bizplan-java.com
SMTP_PASS=
SMTP_FROM=Bizplan Java Agent <notification@bizplan-java.com>
APP_URL=http://agent-02.bizplan-java.com:3000
