{
  "$description": "Single source of truth for the Bizplan Java Agent design system (web + Android). Edit here, then run: python3 design/build_tokens.py",
  "color": {
    "teal":  { "50": "#E6F7F5", "100": "#C0EDE8", "200": "#8FDFD7", "300": "#5BCEC3", "400": "#33BCAD", "500": "#15A697", "600": "#0E8579", "700": "#0A6A5F", "800": "#074D45", "900": "#04332E" },
    "red":   { "50": "#FDECEC", "100": "#FAD0D0", "400": "#EF5350", "500": "#E13838", "600": "#C42B2B" },
    "amber": { "500": "#F5A623" },
    "green": { "500": "#2FA84F" },
    "blue":  { "500": "#2A74D4" }
  },
  "semantic": {
    "light": {
      "primary": "#15A697", "primaryHover": "#33BCAD", "primaryPressed": "#0E8579", "onPrimary": "#FFFFFF",
      "danger": "#E13838", "warning": "#F5A623", "success": "#2FA84F", "info": "#2A74D4",
      "ink": "#0F1F1D", "mute": "#5A6B68", "rule": "#E1E9E7",
      "bg": "#F5F9F8", "surface": "#FFFFFF", "surfaceMuted": "#ECF3F1", "zebra": "#FBFBF9"
    },
    "dark": {
      "primary": "#33BCAD", "primaryHover": "#5BCEC3", "primaryPressed": "#15A697", "onPrimary": "#04332E",
      "danger": "#EF5350", "warning": "#F5A623", "success": "#2FA84F", "info": "#2A74D4",
      "ink": "#E8EEEC", "mute": "#9AB0AC", "rule": "#2A3A37",
      "bg": "#0E1413", "surface": "#1B2524", "surfaceMuted": "#121A19", "zebra": "#18211F"
    }
  },
  "chart": ["#15A697", "#F5A623", "#2A74D4", "#FF6B35", "#0A6A5F", "#9A6CFF", "#2FA84F", "#0EA5E9", "#E13838", "#84CC16"],
  "space":  { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "font":   { "display": "Poppins", "body": "Prompt" },
  "type": {
    "display": { "size": 32, "weight": 800, "font": "display" },
    "h1":      { "size": 24, "weight": 700, "font": "display" },
    "h2":      { "size": 18, "weight": 700, "font": "display" },
    "title":   { "size": 16, "weight": 600, "font": "display" },
    "body":    { "size": 15, "weight": 400, "font": "body" },
    "label":   { "size": 13, "weight": 500, "font": "body" },
    "caption": { "size": 12, "weight": 400, "font": "body" },
    "kpi":     { "size": 28, "weight": 700, "font": "display" }
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320, "page": 280 },
    "easing": {
      "standard":   [0.2, 0.0, 0.0, 1.0],
      "emphasized": [0.3, 0.0, 0.0, 1.0],
      "exit":       [0.4, 0.0, 1.0, 1.0]
    }
  }
}
